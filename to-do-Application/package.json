{
  "name": "wd501-todo-testing",
  "version": "1.0.0",
  "description": "Todo application with Jest unit tests",
  "main": "todo.js",
  "scripts": {
    "test": "jest",
    "format": "prettier --write \"**/*.js\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm test"
    }
  }
}
