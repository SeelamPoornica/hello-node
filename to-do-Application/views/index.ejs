<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>To-Do Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
  <div class="max-w-md mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-2xl font-bold mb-6 text-center">To-Do Manager</h1>

    <!-- Overdue Section -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold flex items-center justify-between border-b pb-2">
        <span>Overdue</span>
        <span class="bg-red-100 text-red-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">
          <%= overdue.length %>
        </span>
      </h2>
      <%- include('todos.ejs', { allTodos: overdue }) %>
    </div>

    <!-- Due Today Section -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold flex items-center justify-between border-b pb-2">
        <span>Due Today</span>
        <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">
          <%= dueToday.length %>
        </span>
      </h2>
      <%- include('todos.ejs', { allTodos: dueToday }) %>
    </div>

    <!-- Due Later Section -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold flex items-center justify-between border-b pb-2">
        <span>Due Later</span>
        <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">
          <%= dueLater.length %>
        </span>
      </h2>
      <%- include('todos.ejs', { allTodos: dueLater }) %>
    </div>
  </div>
</body>
</html>
