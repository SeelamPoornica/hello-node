<!-- views/todos.ejs -->
<ul class="list-none p-0 my-2">
  <% for (var i = 0; i < data.length; i++) { %>
    <li class="flex items-center justify-between py-2 border-b">
      <div class="flex items-center">
        <input 
          type="checkbox" 
          class="mr-2 h-4 w-4 text-blue-600" 
          <%= data[i].completed ? 'checked' : '' %> 
          onclick="updateTodo(<%= data[i].id %>)"
        />
        <span class="<%= data[i].completed ? 'line-through text-gray-500' : '' %>">
          <%= data[i].title %>
        </span>
      </div>
      <a href="javascript:void(0)" onclick="deleteTodo(<%= data[i].id %>)" class="text-red-500 hover:text-red-700 ml-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      </a>
    </li>
  <% } %>
</ul>
